# Copy to .env and fill in. Never commit .env.

# --- LiveKit Cloud ---
# Project settings -> Keys, at https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Groq (LLM: agent brain + post-call analysis) ---
# https://console.groq.com/keys
GROQ_API_KEY=

# --- Deepgram (STT + TTS) ---
# https://console.deepgram.com
DEEPGRAM_API_KEY=

# --- Opik (observability + evaluation) ---
# https://www.comet.com/opik  -> user menu -> API key
OPIK_API_KEY=
OPIK_WORKSPACE=

# --- Telephony (real phone calls only; unused in browser development) ---
# Must match the credential list on the SIP trunk (Plivo Zentrunk or Twilio).
# See telephony/README.md.
SIP_AUTH_USERNAME=
SIP_AUTH_PASSWORD=
# From `lk sip outbound list`
SIP_OUTBOUND_TRUNK_ID=

# The phone a demo call rings. Seed patients carry fictional numbers, so a real
# one is set here and never committed. E.164, e.g. +91XXXXXXXXXX.
DEMO_DIAL_TO=
