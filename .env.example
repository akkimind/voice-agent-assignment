# Copy to .env and fill in. Never commit .env.

# --- LiveKit Cloud ---
# Project settings -> Keys, at https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Groq (LLM: agent brain + post-call analysis) ---
# https://console.groq.com/keys
GROQ_API_KEY=

# --- Deepgram (STT + TTS) ---
# https://console.deepgram.com
DEEPGRAM_API_KEY=

# --- Opik (observability + evaluation) ---
# https://www.comet.com/opik  -> user menu -> API key
OPIK_API_KEY=
OPIK_WORKSPACE=

# --- Telephony (real phone calls only; unused in browser calls) ---
# From your SIP provider's trunk; see README -> Phone calls.
SIP_TRUNK_ADDRESS=
# The number calls come from, in international format, e.g. +14155550100.
SIP_CALLER_ID=
# The credential list on the provider's trunk.
SIP_AUTH_USERNAME=
SIP_AUTH_PASSWORD=
# Written by `install.py --trunk`, which creates the LiveKit trunk from the four above.
SIP_OUTBOUND_TRUNK_ID=

# The phone a demo call rings. Seed patients carry fictional numbers, so a real
# one is set here and never committed. E.164, e.g. +91XXXXXXXXXX.
DEMO_DIAL_TO=
